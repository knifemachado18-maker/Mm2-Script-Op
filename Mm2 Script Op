	fpsActive = false

	fpsButton.Text =
		"⚡ FPS BOOSTER: OFF"

	fpsButton.BackgroundColor3 =
		Color3.fromRGB(45, 45, 45)

	for obj, material in pairs(originalMaterials) do

		if obj and obj.Parent then
			obj.Material = material
		end
	end

	originalMaterials = {}
end

fpsButton.MouseButton1Click:Connect(function()

	if fpsActive then
		disableFPS()
	else
		enableFPS()
