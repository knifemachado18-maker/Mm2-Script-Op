-- 2. HIGHLIGHT
--========================================================--

local highlightButton =
	createPowerButton("👁️ HIGHLIGHT")

local highlightActive = false
local playerConnections = {}

local function removeHighlight(character)

	if not character then
		return
	end

	local highlight =
		character:FindFirstChild("FireHighlight")

	if highlight then
		highlight:Destroy()
	end

	local head = character:FindFirstChild("Head")

	if head then

		local billboard =
			head:FindFirstChild("FireName")

		if billboard then
			billboard:Destroy()
		end
	end
end

local function updateHighlight(other)

	if not highlightActive then
		return
	end

	local character = other.Character

	if not character then
		return
	end

	local highlight =
		character:FindFirstChild("FireHighlight")

	if not highlight then

		highlight = Instance.new("Highlight")
		highlight.Name = "FireHighlight"
		highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = character
	end

	local knife =
		other.Backpack:FindFirstChild("Knife")
		or character:FindFirstChild("Knife")

	local gun =
		other.Backpack:FindFirstChild("Gun")
		or character:FindFirstChild("Gun")

	if knife then

		highlight.FillColor =
			Color3.fromRGB(255, 0, 0)

	elseif gun then

		highlight.FillColor =
			Color3.fromRGB(0, 80, 255)

	else

		highlight.FillColor =
			Color3.fromRGB(0, 255, 0)
	end

	highlight.FillTransparency = 0.45
	highlight.OutlineColor = Color3.new(1, 1, 1)

	local head = character:FindFirstChild("Head")

	if head and not head:FindFirstChild("FireName") then

		local billboard = Instance.new("BillboardGui")

		billboard.Name = "FireName"
		billboard.Size = UDim2.fromOffset(120, 35)
		billboard.StudsOffset =
			Vector3.new(0, 2.8, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = head

		local text = Instance.new("TextLabel")

		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Text = other.Name
		text.TextColor3 = Color3.new(1, 1, 1)
		text.TextStrokeTransparency = 0
		text.Font = Enum.Font.GothamBold
		text.TextScaled = true
		text.Parent = billboard
	end
end

local function monitorPlayer(other)

	if other == player then
		return
	end

	if playerConnections[other] then
		return
	end

	playerConnections[other] = {}

	table.insert(
		playerConnections[other],
		other.CharacterAdded:Connect(function()

			task.wait(0.5)

			if highlightActive then
				updateHighlight(other)
			end
		end)
	)

	table.insert(
		playerConnections[other],
		other.Backpack.ChildAdded:Connect(function()

			if highlightActive then
				task.wait()
				updateHighlight(other)
			end
		end)
	)

	table.insert(
		playerConnections[other],
		other.Backpack.ChildRemoved:Connect(function()

			if highlightActive then
				task.wait()
				updateHighlight(other)
			end
		end)
	)
end

local function enableHighlight()

	highlightActive = true

	highlightButton.Text =
		"👁️ HIGHLIGHT: ON"

	highlightButton.BackgroundColor3 = ORANGE

	for _, other in ipairs(Players:GetPlayers()) do

		if other ~= player then

			monitorPlayer(other)
			updateHighlight(other)
		end
	end
end

local function disableHighlight()

	highlightActive = false

	highlightButton.Text =
		"👁️ HIGHLIGHT: OFF"

	highlightButton.BackgroundColor3 =
		Color3.fromRGB(45, 45, 45)

	for _, other in ipairs(Players:GetPlayers()) do

		if other ~= player then
			removeHighlight(other.Character)
		end
	end
end

Players.PlayerAdded:Connect(function(other)

	if highlightActive then
		monitorPlayer(other)
	end
end)

highlightButton.MouseButton1Click:Connect(function()

	if highlightActive then
		disableHighlight()
	else
		enableHighlight()
	end
end)

