local aimButton = createPowerButton("🎯 AIM CIRCLE")

local aimActive = false
local aimCooldown = false
local aimTarget = nil
local aimActivation = 0

local circle = Instance.new("Frame")
circle.Name = "AimCircle"
circle.Size = UDim2.fromOffset(
	AIM_RADIUS * 2,
	AIM_RADIUS * 2
)
circle.Position = UDim2.fromScale(0.5, 0.5)
circle.AnchorPoint = Vector2.new(0.5, 0.5)
circle.BackgroundTransparency = 1
circle.Visible = false
circle.Parent = gui

local circleStroke = Instance.new("UIStroke")
circleStroke.Color = Color3.fromRGB(0, 255, 255)
circleStroke.Thickness = 3
circleStroke.Parent = circle

local circleCorner = Instance.new("UICorner")
circleCorner.CornerRadius = UDim.new(1, 0)
circleCorner.Parent = circle

local function getTarget()

	local camera = workspace.CurrentCamera
	local closest = nil
	local closestDistance = math.huge

	local center = Vector2.new(
		camera.ViewportSize.X / 2,
		camera.ViewportSize.Y / 2
	)

	for _, other in ipairs(Players:GetPlayers()) do

		if other ~= player and other.Character then

			local humanoid =
				other.Character:FindFirstChildOfClass("Humanoid")

			local torso =
				other.Character:FindFirstChild("UpperTorso")
				or other.Character:FindFirstChild("Torso")
				or other.Character:FindFirstChild("HumanoidRootPart")

			if humanoid and humanoid.Health > 0 and torso then

				local screenPos, visible =
					camera:WorldToViewportPoint(torso.Position)

				if visible and screenPos.Z > 0 then

					local pos = Vector2.new(
						screenPos.X,
						screenPos.Y
					)

					local distance =
						(pos - center).Magnitude

					if distance <= AIM_RADIUS
						and distance < closestDistance then

						closestDistance = distance
						closest = other
					end
				end
			end
		end
	end

	return closest
end

local function aimAt(target)

	if not target or not target.Character then
		return
	end

	local camera = workspace.CurrentCamera

	local torso =
		target.Character:FindFirstChild("UpperTorso")
		or target.Character:FindFirstChild("Torso")
		or target.Character:FindFirstChild("HumanoidRootPart")

	if torso then

		camera.CFrame = CFrame.lookAt(
			camera.CFrame.Position,
			torso.Position
		)
	end
end

local function stopAim()

	if not aimActive then
		return
	end

	aimActive = false
	aimTarget = nil
	circle.Visible = false

	aimButton.Text =
		"🎯 AIM CIRCLE: COOLDOWN"

	aimButton.BackgroundColor3 =
		Color3.fromRGB(100, 50, 30)

	aimCooldown = true

	task.delay(AIM_COOLDOWN, function()

		aimCooldown = false

		if not aimActive then

			aimButton.Text =
				"🎯 AIM CIRCLE: OFF"

			aimButton.BackgroundColor3 =
				Color3.fromRGB(45, 45, 45)
		end
	end)
end

local function startAim()

	if aimActive or aimCooldown then
		return
	end

	aimActive = true
	aimActivation += 1

	local id = aimActivation

	circle.Visible = true

	aimButton.Text =
		"🎯 AIM CIRCLE: ON"

	aimButton.BackgroundColor3 = ORANGE

	task.spawn(function()

		local start = tick()

		while aimActive
			and aimActivation == id
			and tick() - start < AIM_DURATION do

			local newTarget = getTarget()

			if newTarget then
				aimTarget = newTarget
			end

			if aimTarget then
				aimAt(aimTarget)
			end

			RunService.RenderStepped:Wait()
		end

		if aimActive and aimActivation == id then
			stopAim()
		end
	end)
end

aimButton.MouseButton1Click:Connect(function()

	if aimActive then
		stopAim()
	else
		startAim()
	end
end)

